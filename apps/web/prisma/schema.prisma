// Modelo de dados do Rotamer.
//
// O grafo é a única fonte de verdade: fórmula, descritores e geometria são
// derivados dele e recalculáveis. O que é guardado aqui é o mínimo — o grafo, e
// o rastro do que a pessoa fez com ele.
//
// Não existe tabela de missão do catálogo. O catálogo vive no código,
// versionado junto com as condições que ele avalia — uma missão no banco
// poderia discordar da `spec` que o motor executa, e aí a nota mudaria sem
// ninguém ter mexido em nada (D-12). A tentativa guarda o `slug`. A missão que
// um professor cria é outra coisa: `TeacherQuest`, mais abaixo.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Quem usa: aluno, professor, pesquisador.
model Profile {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  /// Permite ranking por turma sem criar entidade de turma cedo demais.
  institution  String?
  /// `aluno`, `professor` ou `administrador`. Ninguém se autodeclara. O papel é
  /// dado pelo script `apps/web/scripts/promote-teacher.mjs`, rodado por quem tem
  /// acesso ao servidor, ou por um administrador da própria escola pela tela — e,
  /// pela tela, só até `professor` (D-29). Administrador nasce sempre no
  /// terminal: é o que impede uma conta invadida de se multiplicar e mantém a
  /// instância recuperável por quem tem a máquina.
  role         String   @default("aluno")
  createdAt    DateTime @default(now())

  sessions           Session[]
  molecules          Molecule[]
  attempts           Attempt[]
  tutorUsage         TutorUsage[]
  namedBy            MoleculeName[]
  resetCodes         ResetCode[]    @relation("codigoDaConta")
  codesIssued        ResetCode[]    @relation("codigoEmitido")
  teaching           Classroom[]
  enrollments        Enrollment[]
  questsOpened       QuestOpen[]
  teacherQuests      TeacherQuest[]
  assignmentsCreated Assignment[]
  questReports       QuestReport[]
  roleChanges        RoleChange[]   @relation("papelDaConta")
  roleChangesMade    RoleChange[]   @relation("papelMudadoPor")
}

/// Missão que alguém abriu.
///
/// "Travar" é abrir e não cumprir — e abrir é ato deliberado, escolhido numa
/// lista. Gravar isso é o que permite ao painel da turma mostrar onde a aula
/// parou, e não só quem chegou ao fim (D-22).
///
/// Uma linha por pessoa e missão: reabrir não multiplica registro.
model QuestOpen {
  profileId String
  questSlug String
  openedAt  DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, questSlug])
  @@index([questSlug])
}

/// Uma turma.
///
/// Existe para o professor ver onde a turma dele travou — que é a pergunta que
/// faz uma escola adotar o produto. Entrar numa turma é o aluno digitar um
/// código que o professor entrega em sala, pelo mesmo motivo de não haver
/// e-mail na recuperação de senha (D-19).
model Classroom {
  id         String    @id @default(cuid())
  name       String
  teacherId  String
  /// Curto e sem caractere ambíguo: ele é ditado em voz alta para trinta pessoas.
  code       String    @unique
  createdAt  DateTime  @default(now())
  /// Turma arquivada some da lista sem apagar o histórico de ninguém.
  archivedAt DateTime?

  teacher     Profile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  assignments Assignment[]

  @@index([teacherId])
}

/// Um aluno numa turma.
model Enrollment {
  classroomId String
  profileId   String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([classroomId, profileId])
  @@index([profileId])
}

/// Código de uso único para trocar a senha, emitido por um professor.
///
/// Não existe e-mail no caminho: em escola pública muito aluno não tem caixa de
/// entrada própria, e a que tem não abre na aula. Quem recupera a senha é quem
/// está na sala — o professor emite, entrega em mãos e o código morre no
/// primeiro uso ou em 24 horas, o que vier antes.
///
/// O código nunca é guardado: fica só o resumo dele, como se faz com senha e com
/// sessão. Se o banco vazar, os códigos em circulação continuam inúteis.
model ResetCode {
  id         String    @id @default(cuid())
  /// SHA-256 do código, em hexadecimal.
  codeHash   String    @unique
  profileId  String
  issuedById String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  profile  Profile @relation("codigoDaConta", fields: [profileId], references: [id], onDelete: Cascade)
  issuedBy Profile @relation("codigoEmitido", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
}

/// Uma mudança de papel: de qual para qual, em quem, por quem, quando.
///
/// Promover a professor deixou de ser exclusividade do terminal (D-29): um
/// administrador promove os professores da própria escola. Quem dá acesso a
/// quem passa a ser pergunta de escola, e é a primeira pergunta quando um
/// código de senha é emitido para a conta errada — sem esta tabela ela não tem
/// resposta.
///
/// `changedById` nulo é a mudança vinda do terminal: ali não existe conta
/// pedindo, existe acesso ao servidor.
///
/// Uma linha por mudança, nunca sobrescrita. O rastro é o produto da tabela.
model RoleChange {
  id          String   @id @default(cuid())
  profileId   String
  changedById String?
  /// `aluno`, `professor` ou `administrador` — o papel de antes.
  fromRole    String
  /// O papel de depois.
  toRole      String
  createdAt   DateTime @default(now())

  profile   Profile  @relation("papelDaConta", fields: [profileId], references: [id], onDelete: Cascade)
  /// Quem promoveu continua no rastro depois de sair: apagar a conta de quem
  /// deu o acesso não pode apagar o registro de que o acesso foi dado.
  changedBy Profile? @relation("papelMudadoPor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([changedById])
}

/// Sessão de navegador. O cookie carrega só o identificador.
model Session {
  id        String   @id
  profileId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
}

/// Uma molécula salva. O grafo é o que importa; o resto é derivado dele.
model Molecule {
  id          String   @id @default(cuid())
  ownerId     String?
  graph       Json
  smiles      String
  inchiKey    String
  formula     String
  descriptors Json
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  owner    Profile?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  attempts Attempt[]

  /// É por aqui que se detecta duplicata e se dá crédito de redescoberta.
  @@unique([ownerId, inchiKey])
  @@index([inchiKey])
}

/// Uma tentativa de missão, com a nota reavaliada no servidor.
model Attempt {
  id         String   @id @default(cuid())
  profileId  String
  /// Slug da missão no catálogo em código.
  questSlug  String
  moleculeId String
  score      Int
  passed     Boolean
  elapsedMs  Int
  createdAt  DateTime @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  molecule Molecule @relation(fields: [moleculeId], references: [id], onDelete: Cascade)

  /// Onde as pessoas travam é o dado de produto que importa.
  @@index([profileId, questSlug])
  @@index([questSlug, passed])
}

/// Explicação gerada pelo tutor, guardada para não pagar duas vezes pelo mesmo.
///
/// A chave é a molécula, a missão e o tipo de ajuda: o mesmo erro na mesma
/// missão produz a mesma explicação, e ela serve para todo mundo — o texto fala
/// da química, não da pessoa.
model TutorHint {
  id        String   @id @default(cuid())
  inchiKey  String
  questSlug String
  kind      String
  /// Saída do modelo já validada contra o schema fechado.
  payload   Json
  model     String
  createdAt DateTime @default(now())

  @@unique([inchiKey, questSlug, kind])
  @@index([createdAt])
}

/// Quantos pedidos ao tutor cada pessoa fez em cada dia.
///
/// É o teto de gasto: passou do limite, o produto degrada para as dicas
/// determinísticas, que são escritas à mão e não custam nada.
model TutorUsage {
  profileId String
  /// Data em UTC, sem hora.
  day       DateTime @db.Date
  count     Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, day])
}

/// O apelido que alguém deu a uma estrutura dentro do Rotamer.
///
/// A chave é a InChIKey: batizar é por molécula, não por desenho, então duas
/// pessoas que cheguem à mesma estrutura por caminhos diferentes disputam o
/// mesmo nome — e quem chegou primeiro fica com ele.
///
/// **Não é nomenclatura.** O produto não calcula nome IUPAC e não afirma que
/// este é o nome do composto; é autoria dentro do Rotamer, sempre exibida com
/// quem deu (D-15).
model MoleculeName {
  inchiKey  String   @id
  name      String
  profileId String
  /// Guardados para a tela poder mostrar do que se trata sem recalcular nada.
  formula   String
  smiles    String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

/// O que o PubChem já respondeu, guardado.
///
/// A consulta é externa e sai da nossa mão: pode estar fora, pode limitar o
/// ritmo, e não faz sentido perguntar duas vezes a mesma coisa. `found = false`
/// também é resposta, e também vale guardar.
model PubChemName {
  query     String   @id
  found     Boolean
  cid       Int?
  smiles    String?
  title     String?
  formula   String?
  checkedAt DateTime @default(now())
}

/// Se uma estrutura já é conhecida lá fora, por InChIKey.
///
/// É o que separa "ninguém batizou aqui dentro" de "este composto já existe e
/// tem nome" — a diferença que o batismo precisa saber (D-15).
model PubChemKnown {
  inchiKey  String   @id
  known     Boolean
  cid       Int?
  title     String?
  checkedAt DateTime @default(now())
}

/// Uma missão escrita por um professor.
///
/// O que decide química aqui não foi digitado: `goals` só contém condições que
/// saíram de `extractGoals` sobre `answerMolblock`, reanalisado pelo RDKit no
/// servidor no momento de salvar (D-25). Título, enunciado e dicas são texto do
/// professor e não entram em nenhuma conta.
model TeacherQuest {
  id             String    @id @default(cuid())
  teacherId      String
  title          String
  /// O enunciado. Texto puro: sem HTML, sem markdown, sem link.
  brief          String
  /// `string[]`, no máximo 3, na ordem em que são liberadas.
  hints          Json
  /// `Goal[]` — a mesma forma do pacote `quests`: id, label e condition.
  /// Só os objetivos escolhidos; candidato não escolhido não é guardado.
  goals          Json
  /// A resposta que o professor desenhou. **Nunca sai para o cliente do aluno.**
  answerMolblock String
  answerInchiKey String
  createdAt      DateTime  @default(now())
  /// Quem publica conteúdo lido por menor de idade deixa rastro de quando
  /// escreveu — enunciado é editável depois de publicado.
  updatedAt      DateTime  @updatedAt
  /// Arquivar tira do seletor e não tira de mais nada. Apagar não existe.
  archivedAt     DateTime?
  /// Nulo é "só nas minhas listas": a missão nasce fora do catálogo do produto,
  /// e só alcança aluno matriculado numa turma com lista publicada que a
  /// contenha. Preenchido é "publicada no catálogo" — desde então qualquer conta
  /// alcança pela busca, com autoria visível (D-27). Publicar exige
  /// `Profile.institution` preenchida e a missão não arquivada; retirar do
  /// catálogo (voltar a nulo) encerra o acesso pelo catálogo — quem só chegava
  /// por ali deixa de alcançar a missão. "Já abriu" (`QuestOpen`) nunca foi
  /// concessão de acesso; é histórico, não chave (D-27, corrigido no mesmo dia).
  catalogedAt    DateTime?

  teacher Profile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

/// Denúncia de uma missão do catálogo, por qualquer conta que a alcance.
///
/// Não existe tela de moderação nesta fatia (D-27): o que existe é o rastro —
/// quem, quando e o motivo em uma linha — e o botão de retirar, que o próprio
/// professor aciona ou quem administra o servidor por script. A missão
/// continua no ar até alguém retirar.
model QuestReport {
  id         String    @id @default(cuid())
  /// Slug do catálogo do produto ou `professor:<TeacherQuest.id>`.
  questSlug  String
  reporterId String
  /// Motivo em uma linha; teto de 200 caracteres.
  reason     String
  createdAt  DateTime  @default(now())
  /// Nulo é "em aberto". Preenchido é quando alguém tratou — sem tela própria,
  /// é gravado pelo mesmo script que retira a missão do catálogo.
  resolvedAt DateTime?

  reporter Profile @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([questSlug])
}

/// A sequência de missões de uma aula, dentro de uma turma.
model Assignment {
  id          String    @id @default(cuid())
  classroomId String
  /// Quem criou. Fica separado do dono da turma porque a autoria do conteúdo é
  /// pergunta de escola, e coluna esquecida não se recupera depois.
  createdById String
  title       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Enquanto for nulo, é rascunho: o aluno não vê e não abre.
  publishedAt DateTime?
  archivedAt  DateTime?

  classroom Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy Profile          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items     AssignmentItem[]

  @@index([classroomId])
}

/// Um item da lista. `questSlug` é do catálogo (`primeiro-traco`) ou de uma
/// missão do professor (`professor:<TeacherQuest.id>`) — ver §3.4.
model AssignmentItem {
  id           String @id @default(cuid())
  assignmentId String
  /// 1, 2, 3… É o número que o aluno vê na lista e a coluna que o professor lê no quadro.
  position     Int
  questSlug    String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, position])
  @@unique([assignmentId, questSlug])
  @@index([questSlug])
}
