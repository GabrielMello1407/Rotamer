# Copie para .env e preencha. O .env não vai para o repositório.

# ---- banco ----
# Postgres local. Com o docker-compose.yml deste repositório, é esta a URL.
# Em produção, o mesmo banco roda no VPS ao lado do PM2 — muda só o endereço.
DATABASE_URL="postgresql://rotamer:rotamer@localhost:5432/rotamer?schema=public"

# ---- sessão ----
# Segredo que assina o cookie de sessão. Gere um por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---- tutor ----
# Chave do Gemini, usada só na rota de servidor do tutor.
# O tutor explica; ele nunca calcula nem contradiz o RDKit (ver DECISOES.md D-01).
GEMINI_API_KEY=""
# Teto de gasto por usuário por dia, em número de pedidos.
TUTOR_DAILY_LIMIT="30"

# ---- telemetria ----
# Umami auto-hospedado, sem cookie, no mesmo VPS. Sem estas duas variáveis, o
# script não é carregado e o produto funciona igual. O que se mede é onde as
# pessoas param — nunca quem elas são, nem o que desenharam.
UMAMI_SCRIPT_URL=""
UMAMI_WEBSITE_ID=""
