# Variáveis de quem desenvolve, com `pnpm dev`. Copie para .env e preencha;
# o .env não vai para o repositório. Quem sobe a instância com Docker usa o
# .env da raiz do repositório, não este.

# ---- banco ----
# O Postgres que `docker compose up -d postgres` sobe, na raiz do repositório.
# Sem esta variável, o produto sobe sem conta, turma nem lista — o editor
# funciona inteiro.
DATABASE_URL="postgresql://rotamer:rotamer@localhost:5432/rotamer?schema=public"

# ---- tutor ----
# Chave do Gemini, usada só na rota de servidor do tutor.
# O tutor explica; ele nunca calcula nem contradiz o RDKit (ver DECISOES.md D-01).
GEMINI_API_KEY=""
# Teto de gasto por usuário por dia, em número de pedidos.
TUTOR_DAILY_LIMIT="30"
# Modelo do tutor. Vazio usa o padrão do código. Modelo do Gemini sai de
# circulação com o tempo: quando o tutor calar de repente, é aqui que se olha.
GEMINI_MODEL=""

# ---- telemetria (desligada por padrão) ----
# Umami auto-hospedado, sem cookie. Sem estas duas variáveis, o script não é
# carregado e o produto funciona igual. O que se mede é onde as
# pessoas param — nunca quem elas são, nem o que desenharam.
UMAMI_SCRIPT_URL=""
UMAMI_WEBSITE_ID=""
