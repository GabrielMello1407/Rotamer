# Variáveis da instância que sobe com `docker compose up -d`.
# Copie para `.env`, ao lado do docker-compose.yml. O `.env` não vai para o repositório.
# O que cada uma faz, e o que acontece sem ela, está em docs/INSTALACAO.md.

# ---- banco ----
# Senha do Postgres que o compose cria. Troque antes da primeira subida: ela
# fica gravada no volume do banco, e mudar depois exige mudar no banco também.
# Só letras, números e hífen: a senha entra numa URL, e `@`, `#`, `/` e `:` a
# quebram.
POSTGRES_PASSWORD="troque-esta-senha"
# Usuário e nome do banco. Só mude se tiver motivo.
# POSTGRES_USER="rotamer"
# POSTGRES_DB="rotamer"

# ---- rede ----
# Porta da máquina em que o app aparece. Um proxy com TLS na frente é o normal
# para uso fora da rede local.
# ROTAMER_PORT="3000"

# ---- tutor ----
# Chave do Gemini, usada só na rota de servidor do tutor. Sem ela, o tutor se
# desliga e o produto continua inteiro — as dicas das missões são escritas à mão.
GEMINI_API_KEY=""
# Teto de pedidos ao tutor por conta por dia.
TUTOR_DAILY_LIMIT="30"
# Modelo do tutor. Vazio usa o padrão do código; quando o tutor calar de
# repente, é aqui que se olha, porque modelo do Gemini sai de circulação.
GEMINI_MODEL=""

# ---- telemetria (desligada por padrão) ----
# Umami auto-hospedado, sem cookie. Sem estas duas variáveis, nenhum script de
# medição é carregado. O que se mede é onde as pessoas param — nunca quem elas
# são, nem o que desenharam.
UMAMI_SCRIPT_URL=""
UMAMI_WEBSITE_ID=""
